# ---- secrets & personal/local data (never commit) ----
secrets.config
*.local.config
**/04_Create_Admin.local.sql
.env
# local developer-only helper page (shows configuration status; keep it off the repo and off servers)
DevDiagnostics.aspx

# runtime files: dev e-mail outbox (contains e-mail addresses + OTP codes), error logs, local databases
**/App_Data/*
!**/App_Data/README.txt
*.log
*.mdf
*.ldf

# publish profiles contain local paths / credentials
*.pubxml
*.pubxml.user

# ---- Visual Studio / build output ----
.vs/
obj/
*.suo
*.user
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
packages/
TestResults/

# bin/: ignore build output but keep the two third-party DLLs the project references
**/bin/*
!**/bin/itextsharp.dll
!**/bin/itextsharp.xmlworker.dll

# ---- OS / editor ----
Thumbs.db
.DS_Store
*.swp
