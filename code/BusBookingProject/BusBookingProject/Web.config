<?xml version="1.0"?>
<!--
  Maharaja Travel's - application configuration.
  SECRETS (SMTP password, Razorpay keys, OAuth secrets, OTP pepper) do NOT belong in this file.
  Copy secrets.config.example to secrets.config, fill it in, and keep it out of source control (see .gitignore).
-->
<configuration>
  <connectionStrings>
    <!-- Change MYPC\SQLEXPRESS to your SQL Server instance. For a SQL login use: User ID=...;Password=...; -->
    <add name="OnlineBusBookingConnectionString" connectionString="Data Source=MYPC\SQLEXPRESS;Initial Catalog=OnlineBusBooking;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=OnlineBusBooking" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings file="secrets.config">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
    <!-- Public address of the site, used for links in e-mails and OAuth redirect URIs (no trailing slash) -->
    <add key="App:BaseUrl" value="http://localhost:1778"/>
    <add key="App:SupportEmail" value="MaharajaTravels@hotmail.com"/>
    <!-- Security -->
    <add key="Security:RequireHttps" value="true"/>
    <add key="Security:TrustProxyHeaders" value="false"/>
    <add key="Security:Pbkdf2Iterations" value="600000"/>
    <add key="Security:TwoStepForPasswordLogin" value="true"/>
    <add key="Security:MaxFailedLogins" value="5"/>
    <add key="Security:LockoutMinutes" value="15"/>
    <add key="Security:OtpPepper" value=""/>
    <!-- Booking rules -->
    <add key="Booking:MaxSeatsPerBooking" value="3"/>
    <add key="Booking:SeatHoldMinutes" value="10"/>
    <!-- E-mail (SMTP). Leave Smtp:Host empty on a developer PC: messages are then written to App_Data\dev-outbox.log -->
    <add key="Smtp:Host" value=""/>
    <add key="Smtp:Port" value="587"/>
    <add key="Smtp:EnableSsl" value="true"/>
    <add key="Smtp:User" value=""/>
    <add key="Smtp:Password" value=""/>
    <add key="Smtp:From" value=""/>
    <add key="Smtp:FromName" value="Maharaja Travel's"/>
    <!-- SMS OTP. Provider: "" (disabled - OTP goes to e-mail instead) or "Twilio" -->
    <add key="Sms:Provider" value=""/>
    <add key="Sms:Twilio:AccountSid" value=""/>
    <add key="Sms:Twilio:AuthToken" value=""/>
    <add key="Sms:Twilio:From" value=""/>
    <!-- Razorpay (cards, net banking, UPI). Test keys: Razorpay Dashboard > Settings > API Keys -->
    <add key="Razorpay:KeyId" value=""/>
    <add key="Razorpay:KeySecret" value=""/>
    <add key="Razorpay:WebhookSecret" value=""/>
    <!-- Social sign-in (leave ClientId empty to hide the button) -->
    <add key="Google:ClientId" value=""/>
    <add key="Google:ClientSecret" value=""/>
    <add key="Microsoft:ClientId" value=""/>
    <add key="Microsoft:ClientSecret" value=""/>
    <add key="Microsoft:Tenant" value="common"/>
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="2048" executionTimeout="60" requestValidationMode="4.5"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-IN" uiCulture="en"/>
    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Always" controlRenderingCompatibilityVersion="4.0"/>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/Error.aspx?code=404"/>
    </customErrors>
    <authentication mode="Forms">
      <forms name=".MBT_AUTH" loginUrl="~/Login.aspx" defaultUrl="~/Home.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies" protection="All" path="/" requireSSL="false" enableCrossAppRedirects="false"/>
    </authentication>
    <authorization>
      <allow users="*"/>
    </authorization>
    <sessionState mode="InProc" cookieName="MBT_SESSION" timeout="30" cookieless="UseCookies" regenerateExpiredSessionId="true"/>
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax"/>
    <machineKey compatibilityMode="Framework45"/>
  </system.web>
  <!-- Pages that need a signed-in customer -->
  <location path="BookingReport.aspx">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="PassengerDetailsInfo.aspx">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="Payment.aspx">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="BookingConfirmation.aspx">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="Download.ashx">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <!-- Admin area: administrators only (the login page itself stays reachable) -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Admin/AdminLogin.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="2097152"/>
        <hiddenSegments>
          <remove segment="App_Data"/>
          <add segment="App_Data"/>
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".sql"/>
          <add fileExtension=".sql" allowed="false"/>
          <remove fileExtension=".log"/>
          <add fileExtension=".log" allowed="false"/>
        </fileExtensions>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00"/>
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
  </system.webServer>
</configuration>