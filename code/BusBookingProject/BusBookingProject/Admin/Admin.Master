<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="BusBookingProject.Admin.Admin" %>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#4338ca" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin - Maharaja Travel's</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('mbt-theme') || 'system';
                var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link href="~/fontawesome/css/all.min.css" rel="stylesheet" runat="server" />
    <link id="lnkSiteCss" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-shell d-lg-flex">
            <% if (IsAdminSignedIn) { %>
            <aside class="admin-side p-3 flex-shrink-0">
                <a class="d-flex align-items-center gap-2 fw-bold text-decoration-none mb-3" href="<%= ResolveUrl("~/Admin/Default.aspx") %>">
                    <span class="brand-mark"><i class="fa-solid fa-bus"></i></span><span>Admin console</span>
                </a>
                <nav class="nav flex-lg-column gap-1">
                    <a class="nav-link<%= NavActive("Default.aspx") %>" href="<%= ResolveUrl("~/Admin/Default.aspx") %>"><i class="fa-solid fa-gauge fa-fw"></i>Dashboard</a>
                    <a class="nav-link<%= NavActive("BusDetails.aspx") %>" href="<%= ResolveUrl("~/Admin/BusDetails.aspx") %>"><i class="fa-solid fa-bus fa-fw"></i>Add bus</a>
                    <a class="nav-link<%= NavActive("RouteDetails.aspx") %>" href="<%= ResolveUrl("~/Admin/RouteDetails.aspx") %>"><i class="fa-solid fa-route fa-fw"></i>Route info</a>
                    <a class="nav-link<%= NavActive("BusDetailsReport.aspx") %>" href="<%= ResolveUrl("~/Admin/BusDetailsReport.aspx") %>"><i class="fa-solid fa-list fa-fw"></i>Bus info</a>
                    <a class="nav-link<%= NavActive("BusScheduleReport.aspx") %>" href="<%= ResolveUrl("~/Admin/BusScheduleReport.aspx") %>"><i class="fa-solid fa-calendar-days fa-fw"></i>Bus schedule</a>
                    <a class="nav-link<%= NavActive("BookingReport.aspx") %>" href="<%= ResolveUrl("~/Admin/BookingReport.aspx") %>"><i class="fa-solid fa-users-line fa-fw"></i>Booking report</a>
                    <a class="nav-link<%= NavActive("FeedbackReport.aspx") %>" href="<%= ResolveUrl("~/Admin/FeedbackReport.aspx") %>"><i class="fa-solid fa-comments fa-fw"></i>Feedback</a>
                    <a class="nav-link<%= NavActive("AdminChangePassword.aspx") %>" href="<%= ResolveUrl("~/Admin/AdminChangePassword.aspx") %>"><i class="fa-solid fa-key fa-fw"></i>Change password</a>
                </nav>
            </aside>
            <% } %>
            <div class="flex-grow-1 min-w-0">
                <header class="mbt-nav d-flex align-items-center justify-content-between px-3 py-2 sticky-top">
                    <a href="<%= ResolveUrl("~/Default.aspx") %>" class="text-decoration-none small"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>View website</a>
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-icon" type="button" id="themeToggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose theme"><i class="fa-solid fa-circle-half-stroke" data-theme-icon></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="themeToggle">
                                <li><button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="light"><i class="fa-solid fa-sun fa-fw"></i>Light<i class="fa-solid fa-check ms-auto theme-check"></i></button></li>
                                <li><button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="dark"><i class="fa-solid fa-moon fa-fw"></i>Dark<i class="fa-solid fa-check ms-auto theme-check"></i></button></li>
                                <li><button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="system"><i class="fa-solid fa-desktop fa-fw"></i>System default<i class="fa-solid fa-check ms-auto theme-check"></i></button></li>
                            </ul>
                        </div>
                        <% if (IsAdminSignedIn) { %>
                        <span class="small text-body-secondary d-none d-sm-inline"><i class="fa-solid fa-user-shield me-1"></i><asp:Label ID="lblAdmin" runat="server" /></span>
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-danger btn-sm" OnClick="btnLogout_Click" CausesValidation="false"><i class="fa-solid fa-right-from-bracket me-1"></i>Sign out</asp:LinkButton>
                        <% } %>
                    </div>
                </header>
                <main class="admin-content p-3 p-md-4 page-enter">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <div class="toast-container position-fixed top-0 end-0 p-3 mbt-toasts" id="toastHost" aria-live="polite" aria-atomic="true"></div>
    <div id="mbtLoading" class="mbt-loading" hidden><div class="spinner-border text-light" role="status"><span class="visually-hidden">Loading...</span></div></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="<%= Asset("~/js/site.js") %>"></script>
    <asp:ContentPlaceHolder ID="scripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
