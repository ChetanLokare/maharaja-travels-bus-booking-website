<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to "secrets.config" (same folder as Web.config) and fill in real values.
  Anything defined here overrides the matching key in Web.config. NEVER commit secrets.config.
-->
<appSettings>
  <add key="Security:OtpPepper" value="PUT-A-LONG-RANDOM-STRING-HERE" />

  <add key="Smtp:Host" value="smtp.gmail.com" />
  <add key="Smtp:Port" value="587" />
  <add key="Smtp:User" value="your_email@example.com" />
  <add key="Smtp:Password" value="-----Paste_Password-------" />
  <add key="Smtp:From" value="your_email@example.com" />

  <add key="Razorpay:KeyId" value="-------Paste_KeyId---------" />
  <add key="Razorpay:KeySecret" value="-------Paste_KeySecret---------" />
  <add key="Razorpay:WebhookSecret" value="-----ADD_WEBHOOK------" />

  <add key="Google:ClientId" value="xxxx.apps.googleusercontent.com" />
  <add key="Google:ClientSecret" value="xxxx" />
  <add key="Microsoft:ClientId" value="xxxx-xxxx-xxxx" />
  <add key="Microsoft:ClientSecret" value="xxxx" />
</appSettings>
